# Copy this to .env and fill in your keys. Never commit .env.

# Required for the skincare checker AND the voice-inbox transcription + router.
OPENAI_API_KEY=sk-...

# Required for the voice inbox to write to Notion.
# Create at: https://www.notion.so/profile/integrations  (New integration → Internal → copy "Internal Integration Token")
# Then for each Notion page or database you want the inbox to use as a jar:
#   open it → top-right "..." → "Connect to" → pick your integration.
NOTION_TOKEN=secret_...

# Optional. Defaults to 3000.
# PORT=3000

# When deploying (Render, Railway, Fly, etc.), set this to your public URL
# so the inbox & dashboard browser requests are accepted by CORS.
# Comma-separated for multiple. Example:
# ALLOWED_ORIGINS=https://your-app.onrender.com
